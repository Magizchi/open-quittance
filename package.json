{
  "name": "open-quittance",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest",
    "eslint": "eslint .",
    "lint-staged": "lint-staged",
    "prettier": "prettier --plugin-search-dir . --check .",
    "prettier:fix": "prettier --plugin-search-dir . --write .",
    "migrate": "npx drizzle-kit generate --config=drizzle.config.ts && npx drizzle-kit push --config=drizzle.config.ts",
    "commit": "cz"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@iconify/svelte": "^5.2.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/bcrypt": "^6.0.0",
    "@types/blob-stream": "^0.1.33",
    "@types/cookie": "^1.0.0",
    "@types/eslint__js": "^9.14.0",
    "@types/file-saver": "^2.0.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pdfmake": "^0.3.2",
    "autoprefixer": "^10.4.27",
    "conventional-changelog-atom": "^5.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-svelte": "^3.15.2",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.5",
    "svelte-eslint-parser": "^1.6.0",
    "tailwindcss": "^4.2.1",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "type": "module",
  "dependencies": {
    "@auth/sveltekit": "^1.11.1",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "bcrypt": "^6.0.0",
    "blob-stream": "^0.1.3",
    "convertir-nombre-lettre": "^1.0.2",
    "dayjs": "^1.11.20",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "file-saver": "^2.0.5",
    "jsonwebtoken": "^9.0.3",
    "mysql": "^2.18.1",
    "mysql2": "^3.20.0",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.7"
  },
  "lint-staged": {
    "src/**/*": "prettier --write",
    "src/**/*.{svelte,ts}": "eslint"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
